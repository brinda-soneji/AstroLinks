<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login / Register</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex justify-center items-center h-screen">
  <div class="bg-white p-8 rounded shadow-md w-full max-w-md">
    <h1 class="text-2xl font-bold mb-6 text-center">Login / Register</h1>
    <form action="/auth" method="POST" class="space-y-4">
      <input type="hidden" name="action" value="register" id="form-action">
      <div>
        <label for="name" class="block text-gray-700">Name</label>
        <input type="text" id="name" name="name" class="w-full px-3 py-2 border rounded-md" placeholder="Your Name" required>
      </div>
      <div>
        <label for="email" class="block text-gray-700">Email</label>
        <input type="email" id="email" name="email" class="w-full px-3 py-2 border rounded-md" placeholder="Your Email" required>
      </div>
      <div>
        <label for="password" class="block text-gray-700">Password</label>
        <input type="password" id="password" name="password" class="w-full px-3 py-2 border rounded-md" placeholder="Password" required>
      </div>
      <div>
        <label for="role" class="block text-gray-700">Role</label>
        <select id="role" name="role" class="w-full px-3 py-2 border rounded-md" required>
          <option value="enthusiast">Enthusiast</option>
          <option value="researcher">Researcher</option>
          <option value="scientist">Scientist</option>
        </select>
      </div>
      <div id="additional-fields" class="hidden space-y-4">
        <div>
          <label for="degree" class="block text-gray-700">Degree</label>
          <input type="text" id="degree" name="degree" class="w-full px-3 py-2 border rounded-md" placeholder="Your Degree">
        </div>
        <div>
          <label for="researchPaper" class="block text-gray-700">Research Paper</label>
          <input type="text" id="researchPaper" name="researchPaper" class="w-full px-3 py-2 border rounded-md" placeholder="Research Paper Link">
        </div>
      </div>
      <button type="submit" class="w-full bg-blue-500 text-white py-2 rounded-md hover:bg-blue-600">
        Submit
      </button>
    </form>
  </div>
  <script>
    const roleSelect = document.getElementById("role");
    const additionalFields = document.getElementById("additional-fields");
    const formAction = document.getElementById("form-action");

    roleSelect.addEventListener("change", (e) => {
      const selectedRole = e.target.value;
      if (selectedRole === "researcher" || selectedRole === "scientist") {
        additionalFields.classList.remove("hidden");
      } else {
        additionalFields.classList.add("hidden");
      }
    });
  </script>
</body>
</html>